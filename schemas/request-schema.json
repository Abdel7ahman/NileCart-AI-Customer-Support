{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NileCart Customer Request Schema",
  "description": "Structured schema for validating customer request understanding output.",
  "type": "object",
  "required": ["language", "security_flags", "requests"],
  "additionalProperties": false,
  "properties": {
    "language": {
      "type": "string"
    },
    "security_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "prompt_injection",
          "sensitive_data_detected",
          "unauthorized_access_attempt"
        ]
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "intent",
          "entities",
          "problem_summary",
          "customer_intent_text",
          "requires_tool",
          "requires_confirmation",
          "missing_info",
          "needs_clarification",
          "clarification_question"
        ],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "order_status",
              "delivery_eta",
              "change_shipping_address",
              "cancel_order",
              "product_information",
              "product_price",
              "product_availability",
              "product_variant",
              "return_request",
              "exchange_request",
              "refund_status",
              "complaint",
              "other"
            ]
          },
          "entities": {
            "type": "object",
            "required": [
              "order_id",
              "product_id",
              "product_name",
              "size",
              "color",
              "address",
              "customer_reference",
              "refund_reference",
              "delivery_reference"
            ],
            "additionalProperties": false,
            "properties": {
              "order_id": { "type": ["string", "null"] },
              "product_id": { "type": ["string", "null"] },
              "product_name": { "type": ["string", "null"] },
              "size": { "type": ["string", "null"] },
              "color": { "type": ["string", "null"] },
              "address": { "type": ["string", "null"] },
              "customer_reference": { "type": ["string", "null"] },
              "refund_reference": { "type": ["string", "null"] },
              "delivery_reference": { "type": ["string", "null"] }
            }
          },
          "problem_summary": {
            "type": ["string", "null"]
          },
          "customer_intent_text": {
            "type": ["string", "null"]
          },
          "requires_tool": {
            "type": "boolean"
          },
          "requires_confirmation": {
            "type": "boolean"
          },
          "missing_info": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "order_id",
                "product_id",
                "product_name",
                "size",
                "color",
                "address",
                "customer_reference",
                "refund_reference",
                "delivery_reference"
              ]
            }
          },
          "needs_clarification": {
            "type": "boolean"
          },
          "clarification_question": {
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "needs_clarification": { "const": true } },
              "required": ["needs_clarification"]
            },
            "then": {
              "properties": { "clarification_question": { "type": "string" } }
            }
          },
          {
            "if": {
              "properties": {
                "intent": { "enum": ["cancel_order", "change_shipping_address"] }
              },
              "required": ["intent"]
            },
            "then": {
              "properties": { "requires_confirmation": { "const": true } }
            }
          }
        ]
      }
    }
  }
}
